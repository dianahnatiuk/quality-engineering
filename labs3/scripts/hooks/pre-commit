#!/bin/sh
# Pre-commit hook (Лаб. №3): блокує коміт, якщо staged-зміни містять секрети (Gitleaks).
# Проєкт лежить у папці labs3/ спільного репозиторію, тому конфіг шукається відносно кореня репозиторію.
# Підключення (один раз):  labs3\scripts\install-hooks.cmd   -> git config core.hooksPath labs3/scripts/hooks
CONFIG="labs3/.gitleaks.toml"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "[pre-commit] ПОМИЛКА: gitleaks не знайдено в PATH. Встановіть Gitleaks (див. README.md)."
  exit 1
fi

echo "[pre-commit] Gitleaks: перевірка staged-змін..."
if gitleaks git --help >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --verbose --config "$CONFIG"
else
  gitleaks protect --staged --redact --verbose --config "$CONFIG"
fi
RC=$?

if [ "$RC" -ne 0 ]; then
  echo "[pre-commit] SECRET SCAN: FAIL - коміт ЗАБЛОКОВАНО (код $RC)."
  exit "$RC"
fi
echo "[pre-commit] SECRET SCAN: PASS"
exit 0
